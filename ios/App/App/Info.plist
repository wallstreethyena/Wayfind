<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Wayfind</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.gowayfind.app.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wayfind</string>
			</array>
		</dict>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- 2026-09-23 launch hardening: NO UISceneStoryboardFile here. SceneDelegate
	     (see ios/App/App/SceneDelegate.swift) already builds its own UIWindow +
	     WayfindBridgeViewController programmatically in willConnectTo. A storyboard
	     name here made UIKit instantiate ITS OWN initial view controller
	     (CAPBridgeViewController from Main.storyboard) on top of that — a second,
	     unconfigured Capacitor bridge nobody asked for. Main.storyboard is still
	     referenced by the Xcode project's Resources build phase (harmless to leave
	     bundled) but is no longer named as anyone's initial scene. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<!-- 2026-09-23: no UIMainStoryboardFile either, for the same reason — it is
	     the pre-UIScene entry point and is redundant with (and conflicts with)
	     SceneDelegate's own window setup above. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<!-- armv7 was a 32-bit-era leftover; every device this ships to is
		     arm64. Declaring the real architecture, not a legacy default. -->
		<string>arm64</string>
	</array>
	<!-- 2026-09-23 owner decision: iPhone only for v1 (see
	     scripts/check-ios-device-family.mjs). Portrait only — the layout is
	     built and verified at 390px and has never been designed for
	     landscape. No ~ipad key: TARGETED_DEVICE_FAMILY "1" means iPad never
	     reads this file at all, and a stale ~ipad key here would be exactly
	     the kind of dead config that quietly reactivates on the next
	     "helpful" device-family flip. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Wayfind uses these for real features, not boilerplate: camera/photo
	     library back the Community-takes review-photo composer (Detail.js),
	     location backs "near me" search and the tonight/nearby rails, and
	     push notifications back re-engagement (deal alerts, saved-place
	     updates). Apple review reads these strings, so each one states the
	     ACTUAL feature, not a generic placeholder. -->
	<key>NSCameraUsageDescription</key>
	<string>Wayfind uses your camera so you can add a photo to a place review.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Wayfind needs access to your photo library so you can attach photos to a place review.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Wayfind can save a shareable photo card of a place to your photo library.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Wayfind uses your location to show places, deals, and things to do near you right now.</string>
	<!-- Wayfind implements no custom/proprietary encryption beyond standard
	     HTTPS (TLS) — this skips the manual export-compliance question on
	     every TestFlight/App Store build upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
