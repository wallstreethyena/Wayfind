<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PrivacyInfo.xcprivacy — Wayfind's app-level privacy manifest.

  Required since May 2024. Without it the upload is rejected with ITMS-91053
  ("Missing API declaration") before a human reviewer ever sees the build.

  EVERY ENTRY BELOW WAS DERIVED FROM THE CODE, NOT FROM A TEMPLATE. A privacy
  manifest that over-declares is a false statement about the product in the
  same way an under-declaring one is, and the App Store privacy label is
  generated from it. The source for each is named inline.

  NSPrivacyTracking is false, and that is a load-bearing claim rather than a
  default: it is only true because no Google Ads click identifier is captured
  inside the shell. See lib/attribution.js and app/components/GoogleTags.js,
  locked by scripts/check-native-no-ad-tracking.mjs. If that gate is ever
  removed, THIS FILE BECOMES A FALSE STATEMENT — which is why the two ship
  together and why the guard names this file.
-->
<plist version="1.0">
<dict>
	<!-- No data is used to track. No ATT prompt, and none needed. -->
	<key>NSPrivacyTracking</key>
	<false/>

	<!-- Empty because nothing is tracked. A domain listed here would be blocked
	     by the system when the user has not granted ATT. -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Apple Sign In requests [.fullName, .email]
		     (ios/App/App/AppleSignInPlugin.swift:23). Linked: the account IS the
		     identity. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- The Supabase user id, and the same id passed to posthog.identify()
		     (app/home.js). Declared as linked BECAUSE of that identify call — an
		     anonymous device id would not need this entry. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>

		<!-- navigator.geolocation.getCurrentPosition (app/home.js,
		     app/order-in/OrderInClient.js) → sent to our own API to rank places
		     near the user. Declared PRECISE: enableHighAccuracy is not set, but
		     iOS still returns full-resolution coordinates by default, and the
		     honest reading of "what could this deliver" is precise.

		     NOT linked: coordinates are used for the query and the map centre
		     (localStorage wf_center). They are not written to the account. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePreciseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- nativePickPhoto (lib/native.js) hands a File to the existing upload
		     pipeline, so a chosen photo genuinely leaves the device and is
		     attached to the user's own content. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- PostHog product analytics: saves, taps, sheet opens. Linked because
		     posthog.identify() runs on sign-in. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Sentry. NOT linked: lib/sentryShared.js sets sendDefaultPii: false,
		     which scrubs IPs, cookies and request bodies. If that flag is ever
		     flipped to true, this entry must become Linked. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePerformanceData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<!-- Required-reason APIs. UserDefaults is reached through the Capacitor
	     runtime (plugin configuration and push-notification state), not from
	     our own Swift — ios/App/App/*.swift contains zero UserDefaults
	     references. CA92.1 is the correct reason: the data never leaves the
	     app and is not used for tracking.

	     Nothing else is declared, deliberately. File-timestamp, disk-space,
	     system-boot-time and active-keyboard APIs are not reached by this
	     target, and declaring an API we do not call would be as inaccurate as
	     omitting one we do. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
